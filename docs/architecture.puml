@startuml
title Infograf Architecture
skinparam backgroundColor #020617
skinparam defaultFontName Monospaced
skinparam shadowing false
skinparam ArrowColor #94a3b8
skinparam componentStyle rectangle

actor "User" as user
rectangle "Browser / Authoring UI\n(TypeScript + SVG)" as fe #083344
rectangle "Go Modular Monolith\nREST + SSE/WebSocket" as be #064e3b
database "SQLite\nconfig / revisions / audit / metadata" as db #312e81
component "Source Registry\nConnectors + Semantic Model" as src #0f766e
component "Expression Engine\nRules + Thresholds + Durations" as expr #14532d
component "Scene Engine\nBindings + Timeline + Replay" as scene #1e40af
component "Action Engine\nLocal hooks + external hooks" as action #7c2d12
component "Plugin Runtime\nWASM or constrained out-of-process" as plugin #3f3f46
cloud "External Sources\nPrometheus / Graphite / CSV / REST" as extsrc #075985
cloud "External Actions\nPagerDuty / Webhook / Slack" as extaction #7f1d1d

user --> fe : author / simulate / replay
fe --> be : API calls + live updates
be --> db : read/write revisions
be --> src
be --> expr
be --> scene
be --> action
src --> extsrc
action --> extaction
plugin --> src
plugin --> action
be --> plugin : plugin contract
scene --> fe : render state
expr --> scene : evaluation results

package "Security Plane" {
  component "AuthN/AuthZ\nlocal / LDAP / OIDC / mTLS" as sec #831843
  component "Audit + Snapshots\nimmutable history" as audit #881337
}

user --> sec
sec --> be
be --> audit
audit --> db
@enduml
